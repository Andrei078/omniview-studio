{
  "name": "omniview",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "OmniView — open, organize and edit files in the browser. Static site, no backend.",
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "test": "vitest run",
    "build:sw": "node scripts/build-sw.mjs",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "icons": "node scripts/make-icons.mjs",
    "vendor": "node scripts/vendor.mjs",
    "lint": "eslint js",
    "package": "node scripts/package-site.mjs",
    "e2e": "node tests/e2e/shots.mjs && node tests/e2e/subs.mjs && node tests/e2e/touch.mjs && node tests/e2e/offline.mjs",
    "e2e:shots": "node tests/e2e/shots.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/mountains-of-christmas": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "3.11.174",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^24.1.3",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "puppeteer-core": "^25.14.0"
  }
}
